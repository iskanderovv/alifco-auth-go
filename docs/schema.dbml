Project oauth_service {
  database_type: 'PostgreSQL'
}

Enum oauth_provider {
  google
  facebook
  telegram
}

Enum oauth_mode {
  login
  link
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(320) [note: 'set only when the provider verified it. Not unique']
  name varchar(255) [not null]
  avatar_url text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
}

Table oauth_identities {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  provider oauth_provider [not null]
  provider_user_id varchar(255) [not null, note: 'Google sub, Facebook id, Telegram sub']
  email varchar(320) [note: 'as reported by the provider, never trusted']
  created_at timestamptz [not null, default: `now()`]
  last_login_at timestamptz

  indexes {
    (provider, provider_user_id) [unique, name: 'uq_identity_provider_subject']
    (user_id, provider) [unique, name: 'uq_identity_user_provider']
  }
}

Table refresh_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  family_id uuid [not null, note: 'one login and all its rotations']
  token_hash char(64) [not null, unique, note: 'SHA-256 of the token']
  expires_at timestamptz [not null]
  revoked_at timestamptz
  user_agent text
  ip inet
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    family_id
  }
}

Table oauth_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  state_hash char(64) [not null, unique, note: 'SHA-256 of the state sent to the provider']
  code_verifier varchar(128) [not null]
  provider oauth_provider [not null]
  mode oauth_mode [not null, default: 'login']
  user_id uuid [note: 'only for mode link']
  expires_at timestamptz [not null]
  consumed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Ref: users.id < oauth_transactions.user_id
